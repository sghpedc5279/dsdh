.wx_bottom_modal_show { visibility: visible; }

.wx_bottom_modal_show .weui-mask { z-index: 5000; }

.wx_bottom_modal_group_container { height: 100%; transition: transform 0.3s=
; }

.wx_bottom_modal_group { width: 100%; height: 100%; display: flex; flex-dir=
ection: column; position: absolute; top: 0px; }

.wx_bottom_modal_group:first-child { position: static; }

.wx_bottom_modal_mask { opacity: var(--opacity); }

.fixed_title { font-size: 15px; text-size-adjust: 100%; }

.fullscreen-padding .wx_bottom_modal_wrp .fade-enter, .fullscreen-padding .=
wx_bottom_modal_wrp .fade-leave-to { opacity: 0; }

.fullscreen-padding .wx_bottom_modal_wrp .fade-enter-active, .fullscreen-pa=
dding .wx_bottom_modal_wrp .fade-leave-active { transition: opacity 0.3s; }

.fullscreen-padding .wx_bottom_modal_wrp .fade-enter-to, .fullscreen-paddin=
g .wx_bottom_modal_wrp .fade-leave { opacity: var(--opacity); }
